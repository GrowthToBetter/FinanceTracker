@baseUrl = http://localhost:3000/api
@token = {{login.response.body.data.token}}

### Health Check
GET http://localhost:3000/health
Accept: application/json

### Register
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "Jean R",
  "email": "jean@example.com",
  "password": "password123"
}

### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "jean@example.com",
  "password": "password123"
}

### Create Wallet
POST {{baseUrl}}/wallets
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "BCA Main Account",
  "type": "BANK",
  "balance": 10000000
}

### List Wallets
GET {{baseUrl}}/wallets
Authorization: Bearer {{token}}
Accept: application/json

### Get Wallet by ID
GET {{baseUrl}}/wallets/1
Authorization: Bearer {{token}}
Accept: application/json

### Update Wallet
PATCH {{baseUrl}}/wallets/1
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "BCA Payroll Account",
  "type": "BANK"
}

### Delete Wallet
DELETE {{baseUrl}}/wallets/1
Authorization: Bearer {{token}}
Accept: application/json

### List Transactions with Pagination & Filtering
GET {{baseUrl}}/transactions?page=1&size=10&type=EXPENSE&status=POSTED
Authorization: Bearer {{token}}
Accept: application/json

### Get Dashboard Summary (Redis Cached)
GET {{baseUrl}}/dashboard/summary
Authorization: Bearer {{token}}
Accept: application/json

### Get Dashboard Cashflow Trends (Redis Cached)
GET {{baseUrl}}/dashboard/cashflow
Authorization: Bearer {{token}}
Accept: application/json

### Create Savings Goal
POST {{baseUrl}}/savings-goals
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "Emergency Fund",
  "targetAmount": 10000000,
  "currentAmount": 2500000
}

### List Savings Goals
GET {{baseUrl}}/savings-goals
Authorization: Bearer {{token}}
Accept: application/json

### Request Async Report Export (CSV / JSON)
POST {{baseUrl}}/reports/export
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "format": "CSV"
}

### Get Current User Profile
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}
Accept: application/json

### Logout User
DELETE {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}
Accept: application/json
